    "8": {
      "uid": 8,
      "key": [
        "демон",
        "монстр",
        "чудовищ",
        "нечисть",
        "нечисти",
        "/Повелител[а-яёa-z-]*\\s+демонов[а-яёa-z-]*/i",
        "/Король[а-яёa-z-]*\\s+демонов[а-яёa-z-]*/i",
